# Settings for setup_model() in the notebooks (from 4.03 on). The provider and the model are chosen in the notebook:
# BASE_URL, API_KEY, MODEL_NAME = setup_model({"model_name": "qwen3.5:9b", "provider": "huggingface"})
# Copy this file to .env and fill in what you need. .env is in .gitignore: never commit it.
# Empty values: setup_model() uses its default or asks you.

# provider "ollama" and "colab": Ollama (needs no key)
OLLAMA_BASE=http://localhost:11434

# provider "huggingface": the Hugging Face endpoints of the course, one per model (key and addresses from the course;
# a public endpoint needs no key)
HF_GATEWAY_KEY=
HF_GATEWAY_BASE_9B=https://6afcc6a9e8852e593c88589f.endpoints.huggingface.cloud/v1
HF_GATEWAY_BASE_4B=https://6b040364be865bdfb512bc69.endpoints.huggingface.cloud/v1
HF_GATEWAY_BASE_2B=https://6b0404d9f37d8c631304bb95.endpoints.huggingface.cloud/v1

# provider "ai-gateway": AI-Gateway of Paderborn University
AI_GATEWAY_KEY=
AI_GATEWAY_BASE=https://ai-gateway.uni-paderborn.de/v1

# provider "other": another OpenAI-compatible API (the model name goes into the notebook)
OTHER_BASE=
OTHER_KEY=

# 6.04: the course sandbox, runs generated code in a throwaway container (key from the course).
# Without the key: the tests run in a separate process on your computer (no real sandbox).
SANDBOX_URL=https://sandbox.llmresearch.eu
SANDBOX_KEY=
